#include <windows.h>

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "brightnessctl (local build)"
            VALUE "FileDescription",  "Monitor brightness control (DDC/CI + WMI)"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "brightnessctl"
            VALUE "LegalCopyright",   "Open source, built locally from source code"
            VALUE "OriginalFilename", "brightnessctl.exe"
            VALUE "ProductName",      "brightnessctl"
            VALUE "ProductVersion",   "1.0.0.0"
            VALUE "Comments",         "Rewritten from Monitorian's brightness core"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

1 24 "brightnessctl.manifest"
101 ICON "brightnessctl.ico"
3001 RCDATA "ui/index.html"
